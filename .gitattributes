# Generated files: the tools write them with LF, so keep them LF in the working tree too
# (otherwise core.autocrlf=true checks them out CRLF and every regeneration shows them as modified).
data/casting.json text eol=lf
docs/10_CASTING.md text eol=lf
art/leila/palette.json text eol=lf
art/leila/leila.gpl text eol=lf
assets/audio/SOURCES.json text eol=lf

# Shell scripts: CRLF breaks the shebang
*.sh text eol=lf

# Batch files: LF breaks goto/labels (e.g. vendored addons/gdUnit4/runtest.cmd)
*.cmd text eol=crlf

# Godot text resources: the engine writes LF; keep the working tree stable
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdshader text eol=lf
*.godot text eol=lf
*.uid text eol=lf
