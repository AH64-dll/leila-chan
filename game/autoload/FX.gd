extends Node
## FX — screen effects: per-effect stage gates, cooldowns, the per-stage
## baseline (P2.15) and the debug menu.
## docs/02 §2.3 names the effect vocabulary; docs/02 §5 sets the budgets:
## "fx: cooldown per effect 3 turns; shake_big/glitch max 1 per 2 turns".
## The rules table lives in casting.fx and the stage rows in casting.stage_fx
## (both generated by build_casting.py); this autoload only enforces them —
## effect names, gates, gaps and stage amounts are never coded here (role
## playbook: casting.json stays the single source).
##
## Turn gap rule: cooldown_turns N puts the effect on cooldown for the N
## turns after the one it fired on — firing on turn T makes T+1..T+N
## unavailable and T+N+1 the earliest refire. The Director calls
## trigger(name, stage) for a beat's fx pick and end_turn() when the turn
## closes.
##
## Triggered visuals are delegated to the registered host (Character.tscn
## registers itself in _ready): the autoload decides WHETHER an effect runs,
## the host decides HOW it looks. The stage baseline follows the same split:
## set_stage() picks the row, the host ramps it.

signal fx_triggered(name: String)
signal fx_dropped(name: String, reason: String)
signal turn_ended(turn: int)

## The eleven effects FX knows how to draw: the five stage-0 effects from FX v1
## (P1.11) plus the six stage-3/4 effects from P2.15. `desaturation` is not
## here — it is a stage baseline (casting.stage_fx), not a model pick.
const IMPLEMENTED: PackedStringArray = [
	"blush_glow",
	"hearts",
	"sparkle",
	"shake_small",
	"zoom_face",
	"shake_big",
	"flicker",
	"darken",
	"vignette_red",
	"glitch",
	"text_bleed",
]
## docs/02 §2.3: the effects photosensitive mode turns off outright. `flicker`
## is not one of them — it keeps its cue and becomes a dim in the host.
const PHOTOSENSITIVE_OFF: PackedStringArray = ["invert_flash"]
const STAGE_MIN := 0
const STAGE_MAX := 5
const DEBUG_KEY := KEY_F6

var turn_count := 0
## Current instability stage (docs/01 §3). Date/Director keep it in sync; the
## gate checks below still take an explicit stage per call, because a beat is
## judged against the stage it was generated at.
var stage := 0
## docs/02 §2.3 accessibility: no flashes above 3 Hz. The host owns the look
## (flicker dims); this flag owns the one effect the doc switches off.
var photosensitive := false
## Test/tuning seam: merged over casting.fx (name -> partial spec dictionary).
var fx_overrides := {}

var _last_fired := {}  # name -> turn_count of the last firing
var _window_start := {}  # name -> turn_count when the current max_per window opened
var _window_count := {}  # name -> firings inside the current window
var _host_ref: WeakRef
var _menu: CanvasLayer


func _unhandled_input(event: InputEvent) -> void:
	if not OS.is_debug_build():
		return
	var key := event as InputEventKey
	if key == null or not key.pressed or key.echo or key.keycode != DEBUG_KEY:
		return
	toggle_debug_menu()
	get_viewport().set_input_as_handled()


## docs/02 §5: is `name` allowed to fire right now at `stage`? Answers "" when
## it is, else the drop reason a real trigger() would report:
## unknown/gated/photosensitive/unimplemented/cooldown/rate_cap/no_host.
func check(name: String, stage: int) -> String:
	var spec := _spec(name)
	var reason := ""
	if spec.is_empty():
		reason = "unknown"
	elif stage < int(spec.get("gate", 0)):
		reason = "gated"
	elif photosensitive and name in PHOTOSENSITIVE_OFF:
		reason = "photosensitive"
	elif name != "none" and not name in IMPLEMENTED:
		reason = "unimplemented"
	elif _on_cooldown(name, spec):
		reason = "cooldown"
	elif _over_window(name, spec):
		reason = "rate_cap"
	elif name != "none" and not can_play_fx():
		reason = "no_host"
	return reason


## The Director's entry point (docs/02 §4 step 6 -> §5). Returns true when the
## effect actually ran; over-budget picks are dropped silently like the doc's
## other budgets — never sent back to the model. "none" is the default pick:
## it always succeeds and never signals or books a cooldown.
func trigger(name: String, stage: int) -> bool:
	var spec := _spec(name)
	var reason := check(name, stage)
	if not reason.is_empty():
		fx_dropped.emit(name, reason)
		return false
	if name == "none":
		return true
	if _host().play_fx(name) != "":
		fx_dropped.emit(name, "skipped")
		return false
	_record(name, spec)
	fx_triggered.emit(name)
	return true


## Turns advance here, not inside trigger(): several beats can share a turn
## and the doc counts cooldowns in turns, not beats.
func end_turn() -> void:
	turn_count += 1
	turn_ended.emit(turn_count)


## Applies a stage's baseline screen effects (P2.15): looks the row up in
## casting.stage_fx and hands it to the host. Called on every stage change and
## when a scene installs, so a date that opens mid-campaign starts drained.
func set_stage(value: int) -> void:
	stage = clampi(value, STAGE_MIN, STAGE_MAX)
	var profile := stage_profile(stage)
	var host := _host()
	if host != null and host.has_method("apply_stage_fx"):
		host.apply_stage_fx(profile)


## One casting.stage_fx row ({} when the table has no such stage — fail quiet:
## the world simply does not drain). Out-of-range stages clamp to the end rows.
func stage_profile(value: int) -> Dictionary:
	var table: Dictionary = SpriteResolver.casting.get("stage_fx", {})
	var clamped := clampi(value, STAGE_MIN, STAGE_MAX)
	return (table.get(str(clamped), {}) as Dictionary).duplicate()


## docs/02 §2.3 accessibility. The host owns the look (flicker becomes a dim);
## this flag owns the one effect the doc switches off (invert_flash). Pushed
## down so a mode switch lands mid-effect instead of at the next trigger.
func set_photosensitive(enabled: bool) -> void:
	photosensitive = enabled
	var host := _host()
	if host != null and host.has_method("set_photosensitive"):
		host.set_photosensitive(enabled)


## The Character scene registers itself as the visual host. The most recent
## live host wins; dead hosts fall off on access. A late host (scene change)
## starts on the current stage and accessibility mode, never on defaults.
func register_host(node: Node) -> void:
	_host_ref = weakref(node)
	if node.has_method("apply_stage_fx"):
		node.apply_stage_fx(stage_profile(stage))
	if node.has_method("set_photosensitive"):
		node.set_photosensitive(photosensitive)


func unregister_host(node: Node) -> void:
	if _host() == node:
		_host_ref = null


func has_host() -> bool:
	return _host() != null


## True when the registered host can actually draw an effect. A node without
## play_fx (a test double, a scene mid-rework) is no host for a trigger —
## dropping the pick beats a runtime error inside the Director's turn.
func can_play_fx() -> bool:
	var host := _host()
	return host != null and host.has_method("play_fx")


## The debug menu (F6) force-fires an implemented effect: it bypasses gates,
## cooldown and the window cap, never books a firing into the cooldown tables
## and still respects reduced motion via the host. Returns the host's skip
## reason ("" when it played).
func debug_trigger(name: String) -> String:
	if not name in IMPLEMENTED:
		return "unimplemented"
	var host := _host()
	if host == null or not host.has_method("play_fx"):
		return "no_host"
	var skipped: String = host.play_fx(name)
	if skipped.is_empty():
		fx_triggered.emit(name)
	return skipped


func toggle_debug_menu() -> void:
	if _menu == null:
		_menu = load("res://scenes/debug/FxMenu.tscn").instantiate()
		get_tree().root.add_child(_menu)
	_menu.visible = not _menu.visible
	if _menu.visible:
		_menu.refresh()


func is_debug_menu_open() -> bool:
	return _menu != null and _menu.visible


## New date / new scene / tests: forgets every cooldown and the turn counter.
func reset() -> void:
	turn_count = 0
	_last_fired.clear()
	_window_start.clear()
	_window_count.clear()


## Cooldown state for the debug menu and tests: "" when fireable, else the
## drop reason a real trigger() would report at `stage`.
func status_for(name: String, stage := 99) -> String:
	return check(name, stage)


func _host() -> Node:
	if _host_ref == null:
		return null
	var node: Node = _host_ref.get_ref()
	if node == null:
		_host_ref = null
	return node


func _spec(name: String) -> Dictionary:
	var table: Dictionary = SpriteResolver.casting.get("fx", {})
	if not table.has(name):
		return {}
	var merged: Dictionary = (table[name] as Dictionary).duplicate()
	merged.merge(fx_overrides.get(name, {}), true)
	return merged


func _on_cooldown(name: String, spec: Dictionary) -> bool:
	var gap := int(spec.get("cooldown_turns", 0))
	if gap <= 0 or not _last_fired.has(name):
		return false
	return turn_count - int(_last_fired[name]) <= gap


func _over_window(name: String, spec: Dictionary) -> bool:
	var cap: Dictionary = spec.get("max_per", {})
	if cap.is_empty():
		return false
	var start := int(_window_start.get(name, -1))
	if start < 0 or turn_count - start >= int(cap.get("turns", 1)):
		return false  # window expired; the next firing opens a fresh one
	return int(_window_count.get(name, 0)) >= int(cap.get("count", 1))


func _record(name: String, spec: Dictionary) -> void:
	_last_fired[name] = turn_count
	var cap: Dictionary = spec.get("max_per", {})
	if cap.is_empty():
		return
	var start := int(_window_start.get(name, -1))
	if start < 0 or turn_count - start >= int(cap.get("turns", 1)):
		_window_start[name] = turn_count
		_window_count[name] = 0
	_window_count[name] = int(_window_count.get(name, 0)) + 1
