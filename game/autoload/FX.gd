extends Node
## FX — screen effects: per-effect stage gates, cooldowns and the debug menu.
## docs/02 §2.3 names the effect vocabulary; docs/02 §5 sets the budgets:
## "fx: cooldown per effect 3 turns; shake_big/glitch max 1 per 2 turns".
## The rules table lives in casting.fx (generated by build_casting.py); this
## autoload only enforces it — effect names, gates and gaps are never coded
## here (role playbook: casting.json stays the single source).
##
## Turn gap rule: cooldown_turns N puts the effect on cooldown for the N
## turns after the one it fired on — firing on turn T makes T+1..T+N
## unavailable and T+N+1 the earliest refire. The Director calls
## trigger(name, stage) for a beat's fx pick and end_turn() when the turn
## closes.
##
## Triggered visuals are delegated to the registered host (Character.tscn
## registers itself in _ready): the autoload decides WHETHER an effect runs,
## the host decides HOW it looks.

signal fx_triggered(name: String)
signal fx_dropped(name: String, reason: String)
signal turn_ended(turn: int)

## The five effects FX v1 implements (P1.11); casting knows the other names
## but the scene has no visual for them yet — they drop as "unimplemented".
const IMPLEMENTED: PackedStringArray = [
	"blush_glow", "hearts", "sparkle", "shake_small", "zoom_face"
]
const DEBUG_KEY := KEY_F6

var turn_count := 0
## Test/tuning seam: merged over casting.fx (name -> partial spec dictionary).
var fx_overrides := {}

var _last_fired := {}  # name -> turn_count of the last firing
var _window_start := {}  # name -> turn_count when the current max_per window opened
var _window_count := {}  # name -> firings inside the current window
var _host_ref: WeakRef
var _menu: CanvasLayer


func _unhandled_input(event: InputEvent) -> void:
	if not OS.is_debug_build():
		return
	var key := event as InputEventKey
	if key == null or not key.pressed or key.echo or key.keycode != DEBUG_KEY:
		return
	toggle_debug_menu()
	get_viewport().set_input_as_handled()


## docs/02 §5: is `name` allowed to fire right now at `stage`? Answers "" when
## it is, else the drop reason a real trigger() would report:
## unknown/gated/unimplemented/cooldown/rate_cap/no_host.
func check(name: String, stage: int) -> String:
	var spec := _spec(name)
	var reason := ""
	if spec.is_empty():
		reason = "unknown"
	elif stage < int(spec.get("gate", 0)):
		reason = "gated"
	elif name != "none" and not name in IMPLEMENTED:
		reason = "unimplemented"
	elif _on_cooldown(name, spec):
		reason = "cooldown"
	elif _over_window(name, spec):
		reason = "rate_cap"
	elif name != "none" and _host() == null:
		reason = "no_host"
	return reason


## The Director's entry point (docs/02 §4 step 6 -> §5). Returns true when the
## effect actually ran; over-budget picks are dropped silently like the doc's
## other budgets — never sent back to the model. "none" is the default pick:
## it always succeeds and never signals or books a cooldown.
func trigger(name: String, stage: int) -> bool:
	var spec := _spec(name)
	var reason := check(name, stage)
	if not reason.is_empty():
		fx_dropped.emit(name, reason)
		return false
	if name == "none":
		return true
	if _host().play_fx(name) != "":
		fx_dropped.emit(name, "skipped")
		return false
	_record(name, spec)
	fx_triggered.emit(name)
	return true


## Turns advance here, not inside trigger(): several beats can share a turn
## and the doc counts cooldowns in turns, not beats.
func end_turn() -> void:
	turn_count += 1
	turn_ended.emit(turn_count)


## The Character scene registers itself as the visual host. The most recent
## live host wins; dead hosts fall off on access.
func register_host(node: Node) -> void:
	_host_ref = weakref(node)


func unregister_host(node: Node) -> void:
	if _host() == node:
		_host_ref = null


func has_host() -> bool:
	return _host() != null


## The debug menu (F6) force-fires an implemented effect: it bypasses gates,
## cooldown and the window cap, never books a firing into the cooldown tables
## and still respects reduced motion via the host. Returns the host's skip
## reason ("" when it played).
func debug_trigger(name: String) -> String:
	if not name in IMPLEMENTED:
		return "unimplemented"
	var host := _host()
	if host == null:
		return "no_host"
	var skipped: String = host.play_fx(name)
	if skipped.is_empty():
		fx_triggered.emit(name)
	return skipped


func toggle_debug_menu() -> void:
	if _menu == null:
		_menu = load("res://scenes/debug/FxMenu.tscn").instantiate()
		get_tree().root.add_child(_menu)
	_menu.visible = not _menu.visible
	if _menu.visible:
		_menu.refresh()


func is_debug_menu_open() -> bool:
	return _menu != null and _menu.visible


## New date / new scene / tests: forgets every cooldown and the turn counter.
func reset() -> void:
	turn_count = 0
	_last_fired.clear()
	_window_start.clear()
	_window_count.clear()


## Cooldown state for the debug menu and tests: "" when fireable, else the
## drop reason a real trigger() would report at `stage`.
func status_for(name: String, stage := 99) -> String:
	return check(name, stage)


func _host() -> Node:
	if _host_ref == null:
		return null
	var node: Node = _host_ref.get_ref()
	if node == null:
		_host_ref = null
	return node


func _spec(name: String) -> Dictionary:
	var table: Dictionary = SpriteResolver.casting.get("fx", {})
	if not table.has(name):
		return {}
	var merged: Dictionary = (table[name] as Dictionary).duplicate()
	merged.merge(fx_overrides.get(name, {}), true)
	return merged


func _on_cooldown(name: String, spec: Dictionary) -> bool:
	var gap := int(spec.get("cooldown_turns", 0))
	if gap <= 0 or not _last_fired.has(name):
		return false
	return turn_count - int(_last_fired[name]) <= gap


func _over_window(name: String, spec: Dictionary) -> bool:
	var cap: Dictionary = spec.get("max_per", {})
	if cap.is_empty():
		return false
	var start := int(_window_start.get(name, -1))
	if start < 0 or turn_count - start >= int(cap.get("turns", 1)):
		return false  # window expired; the next firing opens a fresh one
	return int(_window_count.get(name, 0)) >= int(cap.get("count", 1))


func _record(name: String, spec: Dictionary) -> void:
	_last_fired[name] = turn_count
	var cap: Dictionary = spec.get("max_per", {})
	if cap.is_empty():
		return
	var start := int(_window_start.get(name, -1))
	if start < 0 or turn_count - start >= int(cap.get("turns", 1)):
		_window_start[name] = turn_count
		_window_count[name] = 0
	_window_count[name] = int(_window_count.get(name, 0)) + 1
