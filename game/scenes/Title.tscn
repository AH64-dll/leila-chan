[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/Title.gd" id="1_title"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.07, 0.09, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 80
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 48

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="TitleLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.2, 0.25, 1)
theme_override_font_sizes/font_size = 28
text = "Leila-chan"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.65, 0.7, 1)
theme_override_font_sizes/font_size = 14
text = "A Dating Sim"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2

[node name="MenuContainer" type="VBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="NewGameButton" type="Button" parent="Margin/VBox/MenuContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
focus_neighbor_top = NodePath("../QuitButton")
focus_neighbor_bottom = NodePath("../ContinueButton")
focus_next = NodePath("../ContinueButton")
focus_previous = NodePath("../QuitButton")
text = "New Game"

[node name="ContinueButton" type="Button" parent="Margin/VBox/MenuContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
focus_neighbor_top = NodePath("../NewGameButton")
focus_neighbor_bottom = NodePath("../PhotosensitiveButton")
focus_next = NodePath("../PhotosensitiveButton")
focus_previous = NodePath("../NewGameButton")
text = "Continue"

[node name="PhotosensitiveButton" type="Button" parent="Margin/VBox/MenuContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
focus_neighbor_top = NodePath("../ContinueButton")
focus_neighbor_bottom = NodePath("../SettingsButton")
focus_next = NodePath("../SettingsButton")
focus_previous = NodePath("../ContinueButton")
text = "Photosensitive mode: Off"

[node name="PhotosensitiveNotice" type="Label" parent="Margin/VBox/MenuContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.7, 0.75, 0.85)
theme_override_font_sizes/font_size = 10
text = "Notice: Flashing lights appear from stage 3. Mode is available above."
horizontal_alignment = 1
autowrap_mode = 2

[node name="SettingsButton" type="Button" parent="Margin/VBox/MenuContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
focus_neighbor_top = NodePath("../PhotosensitiveButton")
focus_neighbor_bottom = NodePath("../ExtrasButton")
focus_next = NodePath("../ExtrasButton")
focus_previous = NodePath("../PhotosensitiveButton")
text = "Settings"

[node name="ExtrasButton" type="Button" parent="Margin/VBox/MenuContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
focus_neighbor_top = NodePath("../SettingsButton")
focus_neighbor_bottom = NodePath("../QuitButton")
focus_next = NodePath("../QuitButton")
focus_previous = NodePath("../SettingsButton")
text = "Extras"

[node name="QuitButton" type="Button" parent="Margin/VBox/MenuContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
focus_neighbor_top = NodePath("../ExtrasButton")
focus_neighbor_bottom = NodePath("../NewGameButton")
