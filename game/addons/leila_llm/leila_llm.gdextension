[configuration]

entry_symbol = "leila_llm_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://addons/leila_llm/bin/linux/libleila_llm.so"
linux.release.x86_64 = "res://addons/leila_llm/bin/linux/libleila_llm.so"
windows.debug.x86_64 = "res://addons/leila_llm/bin/windows/leila_llm.dll"
windows.release.x86_64 = "res://addons/leila_llm/bin/windows/leila_llm.dll"
macos.debug = "res://addons/leila_llm/bin/macos/libleila_llm.dylib"
macos.release = "res://addons/leila_llm/bin/macos/libleila_llm.dylib"
