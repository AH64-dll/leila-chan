# --- Local-only artifacts (too large / machine-specific; see README "Local artifacts") ---

# LLM model weights (2.6 GB) — download separately, see README
models/
*.gguf
# ...except the steering control vectors: a shipped game asset of 10–60 KB each
# (docs/06 §2), not a model weight. Built by experiments/steer_build.py from the
# pinned GGUF and committed so a fresh clone can bind the dose (P2.03).
!game/data/steering/*.gguf

# llama.cpp binary distribution — download separately, see README
tools/llama/

# Godot editor/runtime binaries — download separately, see README
tools/godot/

# Godot editor/import cache inside the project
game/.godot/

# gdUnit4 test reports (regenerated by tools/test.*)
game/reports/

# Raw audio pool (357 MB, re-downloadable from SOURCES.json URLs)
assets/audio/_raw/

# Python
__pycache__/
*.pyc
.venv/
venv/

# HuggingFace / misc caches
.cache/
*.lock

# Superseded first-generation sprite set (kept locally for reference)
art/leila_legacy_1x/

# Review scratch sheets
art/_review/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Prompt-lab run chunks (merged results are committed; chunks are resumable scratch)
tools/promptlab/results/chunks/

# Residual-dump outputs (P3.01): large .npy artifacts, regenerable via tools/steering
experiments/steering/dumps_*/
